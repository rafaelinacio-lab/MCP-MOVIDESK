PORT=3333
# Gere com: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Token de API do Movidesk (recomendado: token de um agente dedicado, só leitura de fato)
MOVIDESK_TOKEN=
MOVIDESK_RPM=10

# Data Lake via PgBouncer (role mcp_ro — ver sql/001_role_mcp_ro.sql). Deixe vazio para desligar as tools datalake_*
DATALAKE_URL=postgres://mcp_ro:SENHA@host.docker.internal:6432/movidesk_painel
DATALAKE_SCHEMAS=gold,silver
DATALAKE_STATEMENT_TIMEOUT_MS=15000
DATALAKE_MAX_ROWS=500

MAX_RESPONSE_CHARS=80000
